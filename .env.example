# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# BREVO_API_KEY: Required for sending real Transactional Email OTPs via Brevo (Sendinblue).
BREVO_API_KEY=

# BREVO_SENDER_EMAIL: The verified sender email address configured in your Brevo account.
BREVO_SENDER_EMAIL=

# BREVO_SENDER_NAME: The display name shown in the recipient's inbox.
BREVO_SENDER_NAME="Recko-India Security"
