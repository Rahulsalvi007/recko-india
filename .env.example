# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyDON20cBa3clvAfdGhn7qJPFVN4jATKhvU"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BREVO_API_KEY: Required for sending real Transactional Email OTPs via Brevo (Sendinblue).
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""

# BREVO_SENDER_EMAIL: The verified sender email address configured in your Brevo account.
# e.g. "salvirahul7038@gmail.com" or "noreply@yourdomain.com"
BREVO_SENDER_EMAIL=""

# BREVO_SENDER_NAME: The display name shown in the recipient's inbox.
BREVO_SENDER_NAME="Recko-India Security"

